                  "id": "details_and_relations_tab",
                  "children": [
                    {
                      "type": "TableView",
                      "id": "components_table",
                      "props": {
                        "label": "token:layout.labels.components"
                      }
                    },
                    {
                      "type": "TableView",
                      "id": "relation_a_table",
                      "props": {
                        "label": "token:layout.labels.relation_a"
                      }
                    },
                    {
                      "type": "TableView",
                      "id": "relation_b_table",
                      "props": {
                        "label": "token:layout.labels.relation_b"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
