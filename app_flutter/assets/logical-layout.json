                ]
              }
            ]
          },
          "bindings": {
            "selection_target": "selected_managed_object"
          }
        },
        {
          "type": "ResizableSplitter",
          "id": "workspace_split",
          "props": {
            "axis": "horizontal",
            "resizable": true
          },
          "children": [
            {
              "type": "TopologyMap",
              "id": "topology_pane"
            },
            {
              "type": "ResizableSplitter",
